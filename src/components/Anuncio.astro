---
// Hueco de anuncio. No pinta nada hasta que haya client y slot en config.ts (Fase 5).
import { ADSENSE } from '../config';
interface Props { slot: keyof typeof ADSENSE.slots; clase?: string; formato?: string }
const { slot, clase = 'ad--incontent', formato = 'auto' } = Astro.props;
const id = ADSENSE.slots[slot];
---
{ADSENSE.client && id && (
  <div class={`ad ${clase}`}>
    <ins class="adsbygoogle" style="display:block" data-ad-client={ADSENSE.client} data-ad-slot={id} data-ad-format={formato} data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
)}
